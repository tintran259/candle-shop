PORT=4000
FRONTEND_URL=http://localhost:3000
# Back Office gọi API: dev 3001, preview / test 3011; khi đưa lên mạng thêm địa chỉ BO thật, cách nhau dấu phẩy
BO_URL=http://localhost:3001,http://localhost:3011
# Neon: copy connection string ở Neon Console, chỉ dán vào .env (không commit), không dán vào file này
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Ký token đăng nhập: chuỗi ngẫu nhiên ≥ 32 ký tự (vd: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=change-me
# PIN đăng nhập BO (6 số, 1 tài khoản). Mã băm tạo bằng: pnpm auth:pin <6 số>
ADMIN_PIN_HASH=

# Kho ảnh Cloudinary (cloudinary.com › Settings › API Keys). Để trống = BO lưu ảnh tạm trong DB. Chỉ dán vào .env, không commit
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Theo dõi lỗi Sentry (project Node) — để trống khi chạy trên máy
SENTRY_DSN=

# VNPay (sandbox: https://sandbox.vnpayment.vn)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/result

# MoMo (sandbox: https://developers.momo.vn)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/checkout/result
MOMO_IPN_URL=http://localhost:4000/api/payments/momo/ipn
